{
  "name": "gyst",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "check": "turbo run //#lint //#format check:types",
    "check:fix": "oxlint --fix && oxfmt",
    "test": "turbo run test",
    "changeset": "changeset",
    "release:version": "changeset version && bun install --lockfile-only",
    "release:publish": "bun scripts/publish.ts"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/bun": "^1.4.2",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2002",
    "turbo": "^2.11.3",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.2"
}
