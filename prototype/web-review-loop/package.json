  },
  "dependencies": {
    "@pierre/diffs": "1.4.3",
    "@pierre/trees": "1.0.0-beta.6",
    "dompurify": "3.4.15",
    "marked": "16.4.2",
    "mermaid": "11.17.2"
  }
}
