{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "../../skills/**"],
      "outputs": [".crust/**"]
    },
    "//#lint": {},
    "//#format": {},
    "topo": {
      "dependsOn": ["^topo"]
    },
    "check:types": {
      "dependsOn": ["topo"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
