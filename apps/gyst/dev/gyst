#!/bin/sh
# The checkout's gyst, run from source on the dev data directory. Put this directory first on PATH
# so you, and agents and the skills they run, reach it as `gyst`. Bare `gyst [range]` and
# `gyst --session <id>` open the session and serve the viewer through the Vite dev server
# (apps/web/dev.ts), which runs until Ctrl-C; every other command runs the source CLI.
set -eu
checkout=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
# apps/web/dev-viewer.ts uses the same directory, so both reach one dev daemon.
export GYST_DATA_DIR="$checkout/.dev/data"
case "${1:-}" in
  session | skills | skill | daemon | -h | --help | -v | --version)
    exec node "$checkout/apps/gyst/src/index.ts" "$@" ;;
  *) exec node "$checkout/apps/web/dev.ts" "$@" ;;
esac
