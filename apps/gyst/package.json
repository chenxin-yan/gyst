{
  "name": "@gyst/cli",
  "version": "0.1.2",
  "description": "Keyboard-centric agent/human co-review",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenxin-yan/gyst.git",
    "directory": "apps/gyst"
  },
  "homepage": "https://github.com/chenxin-yan/gyst#readme",
  "bugs": "https://github.com/chenxin-yan/gyst/issues",
  "publishConfig": {
    "access": "public",
    "directory": ".crust/root"
  },
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "gyst": "src/index.ts"
  },
  "scripts": {
    "build": "vp run build:task"
  },
  "crust": {
    "runtime": "node",
    "artifact": "package",
    "include": [
      "dist/web-ui",
      "dist/export"
    ]
  },
  "dependencies": {
    "@crustjs/core": "0.5.5",
    "@crustjs/effect": "0.2.1",
    "@crustjs/extensions": "0.5.5",
    "@crustjs/skills": "0.5.5",
    "@effect/platform-node": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "@gyst/core": "workspace:*",
    "effect": "catalog:",
    "semver": "7.8.5"
  },
  "devDependencies": {
    "@crustjs/crust": "0.5.5",
    "@gyst/web": "workspace:*",
    "playwright-core": "1.59.1",
    "vitest": "catalog:"
  }
}
