{
  "$schema": "./node_modules/@crustjs/crust/schema/package.json",
  "name": "@gyst/cli",
  "version": "0.0.0",
  "description": "Keyboard-centric agent/human co-review TUI",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenxin-yan/gyst.git",
    "directory": "apps/gyst"
  },
  "homepage": "https://github.com/chenxin-yan/gyst#readme",
  "bugs": "https://github.com/chenxin-yan/gyst/issues",
  "publishConfig": {
    "access": "public"
  },
  "crust": {
    "runtime": "bun",
    "bunPlugins": [
      "@opentui/solid/bun-plugin"
    ]
  },
  "bin": {
    "gyst": "src/index.tsx"
  },
  "scripts": {
    "dev": "bun run src/index.tsx",
    "build": "cp ../../LICENSE LICENSE && cp ../../README.md README.md && crust build --target host",
    "build:release": "cp ../../LICENSE LICENSE && cp ../../README.md README.md && crust build --target bun-linux-x64 --target bun-linux-arm64 --target bun-darwin-x64 --target bun-darwin-arm64 --target bun-windows-x64 --target bun-windows-arm64",
    "start": "bun .crust/root/bin/gyst.js",
    "package:smoke": "bun ../../scripts/package-smoke.ts",
    "release": "crust publish",
    "check:types": "tsc --noEmit",
    "test": "bun test && bun src/tui/smoke.tsx && bun src/tui/app-races.smoke.tsx"
  },
  "devDependencies": {
    "@crustjs/crust": "0.3.4"
  },
  "dependencies": {
    "@crustjs/core": "0.3.4",
    "@crustjs/effect": "0.1.1",
    "@crustjs/extensions": "0.3.4",
    "@crustjs/skills": "0.3.4",
    "@crustjs/tui": "0.0.2",
    "@effect/platform-bun": "4.0.0-rc.116",
    "@gyst/core": "workspace:*",
    "@opentui/solid": "0.5.11",
    "effect": "4.0.0-rc.116",
    "solid-js": "1.9.12"
  }
}
