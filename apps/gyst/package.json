{
  "$schema": "./node_modules/@crustjs/crust/schema/package.json",
  "name": "@gyst/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "crust": {
    "runtime": "bun",
    "bunPlugins": [
      "@opentui/solid/bun-plugin"
    ]
  },
  "bin": {
    "gyst": "src/index.tsx"
  },
  "scripts": {
    "dev": "bun run src/index.tsx",
    "prebuild": "cp ../../LICENSE ../../README.md .",
    "build": "crust build --target host",
    "start": "bun .crust/root/bin/gyst.js",
    "check:types": "tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@crustjs/crust": "0.3.5"
  },
  "dependencies": {
    "@crustjs/core": "0.3.5",
    "@crustjs/effect": "0.1.1",
    "@crustjs/extensions": "0.3.5",
    "@crustjs/skills": "0.3.5",
    "@crustjs/tui": "0.0.2",
    "@effect/platform-bun": "4.0.0-rc.116",
    "@gyst/core": "workspace:*",
    "@opentui/solid": "0.5.11",
    "effect": "4.0.0-rc.116",
    "solid-js": "1.9.12"
  }
}
