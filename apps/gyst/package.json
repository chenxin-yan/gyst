{
  "$schema": "./node_modules/@crustjs/crust/schema/package.json",
  "name": "@gyst/cli",
  "version": "0.1.0",
  "description": "Keyboard-centric agent/human co-review TUI",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenxin-yan/gyst.git",
    "directory": "apps/gyst"
  },
  "homepage": "https://github.com/chenxin-yan/gyst#readme",
  "bugs": "https://github.com/chenxin-yan/gyst/issues",
  "publishConfig": {
    "access": "public"
  },
  "crust": {
    "runtime": "bun",
    "targets": [
      "bun-linux-x64",
      "bun-linux-arm64",
      "bun-darwin-x64",
      "bun-darwin-arm64",
      "bun-windows-x64",
      "bun-windows-arm64"
    ],
    "bunPlugins": [
      "@opentui/solid/bun-plugin"
    ]
  },
  "bin": {
    "gyst": "src/index.tsx"
  },
  "scripts": {
    "dev": "bun run src/index.tsx",
    "prebuild": "cp ../../LICENSE ../../README.md .",
    "build": "crust build",
    "start": "bun .crust/root/bin/gyst.js",
    "release": "crust publish",
    "check:types": "tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@crustjs/crust": "0.4.1"
  },
  "dependencies": {
    "@crustjs/core": "0.4.1",
    "@crustjs/effect": "0.1.2",
    "@crustjs/extensions": "0.4.1",
    "@crustjs/skills": "0.4.1",
    "@crustjs/tui": "0.0.2",
    "@effect/platform-bun": "4.0.0-rc.116",
    "@gyst/core": "workspace:*",
    "@opentui/core": "0.5.12",
    "@opentui/solid": "0.5.12",
    "effect": "4.0.0-rc.116",
    "solid-js": "1.9.15"
  }
}
